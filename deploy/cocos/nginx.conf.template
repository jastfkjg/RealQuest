server {
    listen @LISTEN@;
    server_name _;
    absolute_redirect off;
    root "@ROOT@";
    index index.html;
    server_tokens off;
    autoindex off;
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types application/javascript text/css application/json application/wasm image/svg+xml;
    add_header X-Content-Type-Options nosniff always;
    add_header Cache-Control "no-store" always;

    location = / {
        return 302 /releases/@ACTIVE@/$is_args$args;
    }
    # Older retained pages request a root favicon; the current entry has none.
    location = /favicon.ico {
        return 204;
    }
    location ^~ /api/ {
        proxy_pass http://@UPSTREAM@;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_hide_header Cache-Control;
        proxy_cache off;
    }
    location ^~ /releases/ {
        add_header X-Content-Type-Options nosniff always;
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri $uri/ =404;
    }
    location / {
        return 404;
    }
    error_page 404 = @missing;
    location @missing {
        return 404;
    }
}
