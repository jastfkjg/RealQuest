# Copy to /opt/realquest/app.env, owned by deploy, chmod 600.
# Generate a new password with: openssl rand -hex 32
POSTGRES_PASSWORD=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS
REALQUEST_DOMAIN=realquest.jastcraft.com
COOKIE_SECURE=true
ALLOWED_ORIGINS=https://realquest.jastcraft.com
