{
  "name": "realquest-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test:smoke": "node scripts/smoke.mjs",
    "test:visual": "node scripts/visual-smoke.mjs",
    "test:play-mode": "node scripts/play-mode-smoke.mjs",
    "test:rpg-ui": "node scripts/rpg-ui-smoke.mjs",
    "test:inventory": "node scripts/inventory-smoke.mjs && node scripts/inventory-mutations.mjs",
    "test:journal": "node scripts/journal-smoke.mjs && node scripts/journal-mutations.mjs && node scripts/journal-preview.mjs",
    "test:character": "node scripts/character-points.mjs",
    "test:arrival": "node scripts/arrival-smoke.mjs && node scripts/arrival-capture.mjs && node scripts/arrival-contrast.mjs",
    "test:dialogs": "node scripts/dialogs-capture.mjs && node scripts/dialogs-interactions.mjs",
    "test:encounters": "node scripts/encounter-ui.mjs",
    "test:study": "node scripts/study-smoke.mjs && node scripts/study-contrast.mjs",
    "test:journey": "node scripts/journey-smoke.mjs && node scripts/journey-review.mjs",
    "test:cottage": "node scripts/cottage-smoke.mjs",
    "test:village": "node scripts/village-fine.mjs",
    "test:details": "node scripts/hud-detail.mjs && node scripts/interiors-detail.mjs",
    "test:details:contrast": "node scripts/hud-detail-contrast.mjs",
    "test:hud": "node scripts/hud-smoke.mjs",
    "test:health": "node scripts/health-smoke.mjs",
    "test:knowledge": "node scripts/knowledge-smoke.mjs",
    "test:life": "node scripts/life-commissions-smoke.mjs",
    "test:life-journal": "node scripts/life-journal-dates.mjs && node scripts/life-journal-smoke.mjs",
    "test:market": "node scripts/market-smoke.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "phaser": "^3.90.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "playwright": "^1.51.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.5"
  }
}
